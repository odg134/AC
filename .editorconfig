root = true

[*.{c,cpp,h,hpp}]
# Spaces inside parentheses (all contexts)
cpp_space_within_parentheses = all
cpp_space_within_expression_parentheses = true
cpp_space_within_cast_parentheses = true
cpp_space_within_other_parentheses = true
cpp_space_within_empty_function_parentheses = false
cpp_space_within_empty_lambda_empty_parameter = false
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
